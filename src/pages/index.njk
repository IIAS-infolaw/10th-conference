---
slug: index.html
pageKey: home
---
<header class="hero">
  <div class="cans"></div>
  <h1 class="title item"><img src="/img/title.svg" width="640" height="480" alt="{{ L.name }}"></h1>
  <h2 class="subtitle item"><img src="/img/subtitle.svg" width="560" height="93" alt="{{ L.subtitle }}"></h2>
  <div class="info item">
    <div><time datetime="{{ site.date }}">{{ L.date }}</time></div>
    <div class="venue">{{ L.venue.name }}</div>
    <a role="button" href="{{ site.registrationUrl }}">{{ L.nav.register }}</a>
  </div>
  <nav>
    <ul>
      <li><a href="/{{ locale.prefix }}intro/">{{ L.nav.intro }}</a></li>
      <li><a href="/{{ locale.prefix }}agenda/">{{ L.nav.agenda }}</a></li>
      <li><a href="/{{ locale.prefix }}speakers/">{{ L.nav.speakers }}</a></li>
      <li><a href="/{{ locale.prefix }}events/">{{ L.nav.events }}</a></li>
      <li><a href="/{{ locale.prefix }}venue/">{{ L.nav.venue }}</a></li>
      <li><a href="{{ altUrl }}" hreflang="{{ altLocale.lang }}">{{ L.switchLanguage }}</a></li>
    </ul>
  </nav>
  <div class="cans"></div>
</header>
