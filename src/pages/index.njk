---
slug: index.html
pageKey: home
---
<header class="hero">
  <div class="cans"></div>
  <h1 class="title item"><img src="/img/title.svg" width="372" height="284" alt="{{ site | loc('name') }}"></h1>
  <h2 class="subtitle item"><img src="/img/subtitle.svg" width="400" height="67" alt="{{ site | loc('subtitle') }}"></h2>
  <div class="info">
    <p><time datetime="{{ site.date }}">{{ site.date }}</time> · {{ site | loc("venueName") }}</p>
    <a role="button" href="{{ site.registrationUrl }}">{{ L.nav.register }}</a>
  </div>
  <nav>
    <ul>
      <li><a href="/{{ locale.prefix }}agenda/">{{ L.nav.agenda }}</a></li>
      <li><a href="/{{ locale.prefix }}speakers/">{{ L.nav.speakers }}</a></li>
      <li><a href="/{{ locale.prefix }}events/">{{ L.nav.events }}</a></li>
      <li><a href="/{{ locale.prefix }}venue/">{{ L.nav.venue }}</a></li>
      <li><a href="{{ altUrl }}" hreflang="{{ altLocale.lang }}">{{ L.switchLanguage }}</a></li>
    </ul>
  </nav>
  <div class="cans"></div>
</header>
