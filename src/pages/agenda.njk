---
slug: agenda/index.html
pageKey: agenda
---
<h1>{{ L.nav.agenda }}</h1>
{% for block in program.blocks %}
{% if block.kind == "simple" %}
<section>
  <h2><time>{{ block.startsAt | timeRange(block.endsAt) }}</time> {{ block | loc("title") }}</h2>
</section>
{% else %}
<section>
  <h2><time>{{ block.startsAt | timeRange(block.endsAt) }}</time> {{ block.session | loc("name") }}</h2>
  {% if block.session.moderator %}<p>{{ L.agenda.moderator }}{{ L.punct.colon }}{{ block.session.moderator | loc("name") }}</p>{% endif %}
  {% if block.discussants.length %}<p>{{ L.agenda.discussants if block.discussants.length > 1 else L.agenda.discussant }}{{ L.punct.colon }}{% for p in block.discussants %}{{ p | loc("name") }}{% if not loop.last %}{{ L.punct.listSep }}{% endif %}{% endfor %}</p>{% endif %}
  {% set numbered = block.talks.length > 1 %}
  {% if numbered %}<ol>{% endif %}
    {% for talk in block.talks %}
    {% if numbered %}<li>{% endif %}
      <h3>{{ (talk | loc("title")) or L.agenda.tba }}</h3>
      {% if talk.speakers.length %}
      <p>{{ L.agenda.presenter }}{{ L.punct.colon }}{% for p in talk.speakers %}{{ p | loc("name") }}{% set a = p | affiliation %}{% if a %}{{ L.punct.parenOpen }}{{ a }}{{ L.punct.parenClose }}{% endif %}{% if not loop.last %}{{ L.punct.listSep }}{% endif %}{% endfor %}</p>
      {% endif %}
      {% if talk.paperUrl %}<p><a href="{{ talk.paperUrl }}">{{ L.agenda.paper }}</a></p>{% endif %}
    {% if numbered %}</li>{% endif %}
    {% endfor %}
  {% if numbered %}</ol>{% endif %}
</section>
{% endif %}
{% endfor %}
