---
slug: speakers/index.html
pageKey: speakers
---
<h1>{{ L.nav.speakers }}</h1>
<ul class="speaker-grid">
  {% for person in program.people %}
  <li>
    {% if person.slug %}<a href="/{{ locale.prefix }}speakers/{{ person.slug }}/">{% endif %}
    <img src="{{ person.photo }}" alt="" width="200" height="200" loading="lazy">
    <strong>{{ person | loc("name") }}</strong>
    {% if person.slug %}</a>{% endif %}
    <small>{{ person | affiliation }}</small>
  </li>
  {% endfor %}
</ul>
