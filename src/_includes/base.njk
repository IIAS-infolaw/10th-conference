<!DOCTYPE html>
<html lang="{{ locale.lang }}" class="page-{{ pageKey }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
{%- set metaLabel = pageTitle or (L.nav[pageKey] if pageKey != "home") %}
{%- set metaTitle = (metaLabel + " · " + (site | loc("name"))) if metaLabel else (site | loc("name")) %}
{%- set metaDesc %}{{ site | loc("subtitle") }}{% if site.date %} · {{ site.date }}{% endif %}{% if site | loc("venueName") %} · {{ site | loc("venueName") }}{% endif %}{% endset %}
{%- set canonicalUrl = site.baseUrl + (page.url | url) %}
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDesc }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site | loc("name") }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:locale" content="{{ locale.ogLocale }}">
  <meta property="og:locale:alternate" content="{{ altLocale.ogLocale }}">
  <meta property="og:image" content="{{ site.baseUrl }}{{ site.socialImage | url }}">
  <meta property="og:image:width" content="{{ site.socialImageWidth }}">
  <meta property="og:image:height" content="{{ site.socialImageHeight }}">
  <meta property="og:image:alt" content="{{ site | loc("name") }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.twitterSite }}">
  <link rel="icon" href="/img/favicon.png" type="image/png" sizes="128x128">
  <link rel="stylesheet" href="/css/pico.classless.min.css">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="alternate" hreflang="{{ altLocale.lang }}" href="{{ altUrl }}">
  <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
</head>
<body>
{% if pageKey == "home" %}
{{ content | safe }}
{% else %}
  <header>
    <h1><a class="site-name" href="/{{ locale.prefix }}"><span class="vector">{{ site | loc("name") }}</span></a></h1>
    <nav>
      <ul>
        <li><a href="/{{ locale.prefix }}agenda/">{{ L.nav.agenda }}</a></li>
        <li><a href="/{{ locale.prefix }}speakers/">{{ L.nav.speakers }}</a></li>
        <li><a href="/{{ locale.prefix }}events/">{{ L.nav.events }}</a></li>
        <li><a href="/{{ locale.prefix }}venue/">{{ L.nav.venue }}</a></li>
      </ul>
      <ul>
        <li><a href="{{ altUrl }}" hreflang="{{ altLocale.lang }}">{{ L.switchLanguage }}</a></li>
        <li><a role="button" href="{{ site.registrationUrl }}">{{ L.nav.register }}</a></li>
      </ul>
    </nav>
  </header>
  <main>
{{ content | safe }}
  </main>
{% endif %}
  <footer>
    <nav>
      <ul>
        <li><a href="https://infolaw.iias.sinica.edu.tw"><img src="/img/iias.svg" alt="{{ L.logos.iias }}"></a></li>
        <li><a href="https://www.iias.sinica.edu.tw"><img src="/img/iias-infolaw.svg" alt="{{ L.logos.infolaw }}"></a></li>
        <li><a rel="external" href="https://www.twaicoe.org/"><img src="/img/aicoe.svg" alt="{{ L.logos.aicoe }}"></a></li>
      </ul>
    </nav>
  </footer>
</body>
</html>
